Bootstrap: docker
From: ubuntu:24.04

%help

    This is the base container for running containerized and MPI parallel on
    NEMO2.

    When running on NEMO2, *do not* load any MPI environment. (Slurm takes
    care of process management and any loaded MPI will collide with the MPI
    installation in the container.) Run the container via

      srun container.sif python_script.py

    in your job submission script.

    To run the MPI benchmark, use

      srun apptainer exec container.sif /opt/mpiBench/mpiBench

    in your job submission script.

%post

    export AOCC_VERSION=5.2.0

    export CONTAINER_HWLOC_VERSION=2.14.0
    export CONTAINER_LIBEVENT_VERSION=2.1.13
    export CONTAINER_LIBFABRIC_VERSION=2.7.0
    export CONTAINER_MUNGE_VERSION=0.5.18
    export CONTAINER_UCX_VERSION=1.22.0
    export CONTAINER_UCC_VERSION=1.9.0
    export CONTAINER_PMIX_VERSION=5.0.11  # series bundled with Open MPI 5.0
    export CONTAINER_PRRTE_VERSION=3.0.14  # series bundled with Open MPI 5.0
    export CONTAINER_OMPI_VERSION=5.0.11
    export CONTAINER_MPI4PY_VERSION=4.1.2

    export NPROCS=$(nproc)

    # Set environment variable to contain /usr/local
    # (Avoid trailing colons: an empty entry in LD_LIBRARY_PATH means the
    # current working directory.)
    export PATH=/usr/local/bin:$PATH
    export LD_RUN_PATH=/usr/local/lib${LD_RUN_PATH:+:$LD_RUN_PATH}
    export LD_LIBRARY_PATH=/usr/local/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
    export PKG_CONFIG_PATH=/usr/local/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}
    export MANPATH=/usr/local/share/man${MANPATH:+:$MANPATH}

    # For apt to be noninteractive
    export DEBIAN_FRONTEND=noninteractive
    export DEBCONF_NONINTERACTIVE_SEEN=true

    # Note: gfortran is necessary even if Fortran is not required, because
    # PnetCDF does not compute compile if OpenMPI does not have Fortran
    # support.
    apt-get update
    apt-get install -y strace libnuma-dev libibverbs-dev librdmacm-dev ibverbs-providers libssl-dev curl wget git bash make file pkg-config gcc g++ gfortran python3-dev python3-pip autotools-dev autoconf automake libtool-bin libopenblas-dev libncurses-dev

    # Get AMD compiler (apt resolves the package dependencies, dpkg -i does not)
    cd /tmp
    curl -fL -o aocc-compiler-${AOCC_VERSION}_1_amd64.deb https://download.amd.com/developer/eula/aocc/aocc-$(echo ${AOCC_VERSION} | cut -d. -f1-2 | tr . -)/aocc-compiler-${AOCC_VERSION}_1_amd64.deb
    apt-get install -y ./aocc-compiler-${AOCC_VERSION}_1_amd64.deb
    rm aocc-compiler-${AOCC_VERSION}_1_amd64.deb
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    # Version-independent path to the AOCC installation, used in %environment
    ln -s /opt/AMD/aocc-compiler-${AOCC_VERSION} /opt/AMD/aocc

    # Set AMD as default
    export CC=clang
    export CXX=clang++
    export FC=flang

    # Configure AOCC environment
    . /opt/AMD/aocc-compiler-${AOCC_VERSION}/setenv_AOCC.sh

    # Optimization flags for NEMO2 (AMD EPYC Genoa, Zen4)
    # Note: -march=znver4 emits AVX-512 instructions. Binaries (including
    # configure test programs) will crash with "Illegal instruction" on build
    # machines without AVX-512 (e.g. Zen3). Use "-O3 -mtune=znver4" there.
    export OPT_FLAGS="-O3 -march=znver4"
    export CFLAGS="${OPT_FLAGS}"
    export CXXFLAGS="${OPT_FLAGS}"
    export FFLAGS="${OPT_FLAGS}"
    export FCFLAGS="${OPT_FLAGS}"

    # Download, compile and install HWLOC
    rm -rf /tmp/hwloc-${CONTAINER_HWLOC_VERSION}
    curl -fL https://download.open-mpi.org/release/hwloc/v${CONTAINER_HWLOC_VERSION%.*}/hwloc-${CONTAINER_HWLOC_VERSION}.tar.bz2 | tar -xjC /tmp --no-same-owner
    cd /tmp/hwloc-${CONTAINER_HWLOC_VERSION}
    ./configure --prefix=/usr/local
    make -j ${NPROCS}
    make install
    cd /tmp && rm -rf /tmp/hwloc-${CONTAINER_HWLOC_VERSION}

    # Download, compile and install LIBFABRIC
    rm -rf /tmp/libfabric-${CONTAINER_LIBFABRIC_VERSION}
    curl -fL https://github.com/ofiwg/libfabric/releases/download/v${CONTAINER_LIBFABRIC_VERSION}/libfabric-${CONTAINER_LIBFABRIC_VERSION}.tar.bz2 | tar -xjC /tmp --no-same-owner
    cd /tmp/libfabric-${CONTAINER_LIBFABRIC_VERSION}
    ./configure --prefix=/usr/local
    make -j ${NPROCS}
    make install
    cd /tmp && rm -rf /tmp/libfabric-${CONTAINER_LIBFABRIC_VERSION}

    # Download, compile and install MUNGE
    rm -rf /tmp/munge-${CONTAINER_MUNGE_VERSION}
    curl -fL https://github.com/dun/munge/releases/download/munge-${CONTAINER_MUNGE_VERSION}/munge-${CONTAINER_MUNGE_VERSION}.tar.xz | tar -xJC /tmp --no-same-owner
    cd /tmp/munge-${CONTAINER_MUNGE_VERSION}
    ./configure --prefix=/usr/local
    make -j ${NPROCS}
    make install
    cd /tmp && rm -rf /tmp/munge-${CONTAINER_MUNGE_VERSION}

    # Download, compile and install LIBEVENT
    rm -rf /tmp/libevent-${CONTAINER_LIBEVENT_VERSION}-stable
    curl -fL https://github.com/libevent/libevent/releases/download/release-${CONTAINER_LIBEVENT_VERSION}-stable/libevent-${CONTAINER_LIBEVENT_VERSION}-stable.tar.gz | tar -xzC /tmp --no-same-owner
    cd /tmp/libevent-${CONTAINER_LIBEVENT_VERSION}-stable
    ./configure --prefix=/usr/local
    make -j ${NPROCS}
    make install
    cd /tmp && rm -rf /tmp/libevent-${CONTAINER_LIBEVENT_VERSION}-stable

    # Download, compile and install UCX
    # Check compile options of native UCX on NEMO2 with `ucx_info -b`.
    rm -rf /tmp/ucx-${CONTAINER_UCX_VERSION}
    curl -fL https://github.com/openucx/ucx/releases/download/v${CONTAINER_UCX_VERSION}/ucx-${CONTAINER_UCX_VERSION}.tar.gz | tar -xzC /tmp --no-same-owner
    cd /tmp/ucx-${CONTAINER_UCX_VERSION}
    ./configure --prefix=/usr/local --enable-optimizations --enable-cma --enable-mt --with-verbs --with-rdmacm --without-java --without-go --disable-doxygen-doc --disable-logging --disable-debug --disable-assertions --disable-params-check
    make -j ${NPROCS}
    make install
    cd /tmp && rm -rf /tmp/ucx-${CONTAINER_UCX_VERSION}

    # Download, compile and install UCC
    # Check compile options of native UCC on NEMO2 with `ucc_info -b`.
    rm -rf /tmp/ucc-${CONTAINER_UCC_VERSION}
    curl -fL https://github.com/openucx/ucc/archive/refs/tags/v${CONTAINER_UCC_VERSION}.tar.gz | tar -xzC /tmp --no-same-owner
    cd /tmp/ucc-${CONTAINER_UCC_VERSION}
    ./autogen.sh
    ./configure --prefix=/usr/local --with-ucx=/usr/local
    make -j ${NPROCS}
    make install
    cd /tmp && rm -rf /tmp/ucc-${CONTAINER_UCC_VERSION}

    # Download, compile and install PMIx
    rm -rf /tmp/pmix-${CONTAINER_PMIX_VERSION}
    curl -fL https://github.com/openpmix/openpmix/releases/download/v${CONTAINER_PMIX_VERSION}/pmix-${CONTAINER_PMIX_VERSION}.tar.bz2 | tar -xjC /tmp --no-same-owner
    cd /tmp/pmix-${CONTAINER_PMIX_VERSION}
    ./configure --prefix=/usr/local --with-hwloc=/usr/local --with-libevent=/usr/local --with-munge=/usr/local
    make -j ${NPROCS}
    make install
    cd /tmp && rm -rf /tmp/pmix-${CONTAINER_PMIX_VERSION}

    # Download, compile and install PRRTE
    rm -rf /tmp/prrte-${CONTAINER_PRRTE_VERSION}
    curl -fL https://github.com/openpmix/prrte/releases/download/v${CONTAINER_PRRTE_VERSION}/prrte-${CONTAINER_PRRTE_VERSION}.tar.bz2 | tar -xjC /tmp --no-same-owner
    cd /tmp/prrte-${CONTAINER_PRRTE_VERSION}
    ./configure --prefix=/usr/local --with-hwloc=/usr/local --with-libevent=/usr/local --with-pmix=/usr/local
    make -j ${NPROCS}
    make install
    cd /tmp && rm -rf /tmp/prrte-${CONTAINER_PRRTE_VERSION}

    # Download, compile and install OpenMPI
    # Slurm handles starting of processes and initial communication with the
    # process runs through PMIx. (ORTE and the verbs/openib BTL no longer
    # exist in Open MPI 5, hence no --without-orte/--without-verbs.)
    # Check compile options of native OpenMPI on NEMO2 with `ompi_info`.
    rm -rf /tmp/openmpi-${CONTAINER_OMPI_VERSION}
    curl -fL https://download.open-mpi.org/release/open-mpi/v${CONTAINER_OMPI_VERSION%.*}/openmpi-${CONTAINER_OMPI_VERSION}.tar.bz2 | tar -xjC /tmp --no-same-owner
    cd /tmp/openmpi-${CONTAINER_OMPI_VERSION}
    ./configure --prefix=/usr/local --enable-shared --disable-oshmem --without-psm2 --with-hwloc=/usr/local --with-libevent=/usr/local --with-ofi=/usr/local --with-ucx=/usr/local --with-ucc=/usr/local --with-pmix=/usr/local --with-prrte=/usr/local
    make -j ${NPROCS}
    make install
    cd /tmp && rm -rf /tmp/openmpi-${CONTAINER_OMPI_VERSION}

    # Install mpi4py
    python3 -m pip install --break-system-packages --no-cache-dir --no-binary mpi4py mpi4py==${CONTAINER_MPI4PY_VERSION}

    # Clone and compile MPI benchmark
    cd /opt
    git clone https://github.com/LLNL/mpiBench.git
    cd mpiBench
    make

    # Fetch and compile MPI I/O benchmark
    curl -fL https://fs.hlrs.de/projects/par/mpi/b_eff_io/b_eff_io_v2.1.tar.gz | tar -xzC /opt
    cd /opt/b_eff_io
    mpicc -o b_eff_io b_eff_io.c -lm

%environment

    # Send output directly to screen
    export PYTHONUNBUFFERED=1
    # Don't load modules from $HOME/.local (which is bind-mounted from the host)
    export PYTHONNOUSERSITE=1

    export PATH=/usr/local/bin:$PATH
    export LD_RUN_PATH=/usr/local/lib${LD_RUN_PATH:+:$LD_RUN_PATH}
    export LD_LIBRARY_PATH=/usr/local/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
    export PKG_CONFIG_PATH=/usr/local/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}
    export MANPATH=/usr/local/share/man${MANPATH:+:$MANPATH}

    # Configure AOCC environment
    # (Variables from %post are not available here, hence the symlink.)
    . /opt/AMD/aocc/setenv_AOCC.sh

    # Set AMD as default
    export CC=clang
    export CXX=clang++
    export FC=flang

%runscript

    python3 "$@"
