# DOLFINx Multi-Stage Build Recipe for NEMO2
#
# This recipe creates a minimal runtime container for DOLFINx on NEMO2 (AMD EPYC Milan/Zen3).
# It uses multi-stage builds to exclude compilers and development tools from the
# final image, significantly reducing container size.
#
# Build:
#   apptainer build -F dolfinx.sif dolfinx.def
#
# Usage:
#   srun apptainer run dolfinx.sif script.py
#
# Note: Do NOT load any MPI module on NEMO2. Slurm handles process management.

######################################################################
# STAGE 1: BUILD
# Full development environment with compilers, headers, and build tools
######################################################################

Bootstrap: docker
From: ubuntu:24.04
Stage: build

%arguments
    DOLFINX_VERSION=0.10.0.post5
    BASIX_VERSION=0.10.0.post0
    UFCX_VERSION=0.10.0
    FFCX_VERSION=0.10.1
    PETSC_VERSION=3.21.5
    SLEPC_VERSION=3.21.2
    HDF5_VERSION=1.14.3
    SCALAPACK_VERSION=2.2.1
    FFTW_VERSION=3.3.10
    PYBIND11_VERSION=2.13.6
    NANOBIND_VERSION=2.2.0

    # MPI stack versions (matched to NEMO2)
    AOCC_VERSION=5.0.0
    HWLOC_VERSION=2.10.0
    LIBEVENT_VERSION=2.1.12
    LIBFABRIC_VERSION=1.21.0
    MUNGE_VERSION=0.5.13
    UCX_VERSION=1.16.0
    UCC_VERSION=1.3.0
    PMIX_VERSION=5.0.7
    PRRTE_VERSION=3.0.5
    OMPI_VERSION=5.0.7
    MPI4PY_VERSION=4.0.3

%post
    # ================================================================
    # Configuration from build arguments
    # ================================================================
    DOLFINX_VERSION="{{ DOLFINX_VERSION }}"
    BASIX_VERSION="{{ BASIX_VERSION }}"
    UFCX_VERSION="{{ UFCX_VERSION }}"
    FFCX_VERSION="{{ FFCX_VERSION }}"
    PETSC_VERSION="{{ PETSC_VERSION }}"
    SLEPC_VERSION="{{ SLEPC_VERSION }}"
    HDF5_VERSION="{{ HDF5_VERSION }}"
    SCALAPACK_VERSION="{{ SCALAPACK_VERSION }}"
    FFTW_VERSION="{{ FFTW_VERSION }}"
    PYBIND11_VERSION="{{ PYBIND11_VERSION }}"
    NANOBIND_VERSION="{{ NANOBIND_VERSION }}"

    AOCC_VERSION="{{ AOCC_VERSION }}"
    HWLOC_VERSION="{{ HWLOC_VERSION }}"
    LIBEVENT_VERSION="{{ LIBEVENT_VERSION }}"
    LIBFABRIC_VERSION="{{ LIBFABRIC_VERSION }}"
    MUNGE_VERSION="{{ MUNGE_VERSION }}"
    UCX_VERSION="{{ UCX_VERSION }}"
    UCC_VERSION="{{ UCC_VERSION }}"
    PMIX_VERSION="{{ PMIX_VERSION }}"
    PRRTE_VERSION="{{ PRRTE_VERSION }}"
    OMPI_VERSION="{{ OMPI_VERSION }}"
    MPI4PY_VERSION="{{ MPI4PY_VERSION }}"

    echo "=========================================="
    echo "DOLFINx Build Configuration:"
    echo "  DOLFINx Version: ${DOLFINX_VERSION}"
    echo "  PETSc Version:   ${PETSC_VERSION}"
    echo "  SLEPc Version:   ${SLEPC_VERSION}"
    echo "  HDF5 Version:    ${HDF5_VERSION}"
    echo "  OpenMPI Version: ${OMPI_VERSION}"
    echo "=========================================="

    # ================================================================
    # Environment setup
    # ================================================================
    export PATH=/usr/local/bin:$PATH
    export LD_RUN_PATH=/usr/local/lib:$LD_LIBRARY_PATH
    export LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH
    export PKG_CONFIG_PATH=/usr/local/lib/pkgconfig:$PKG_CONFIG_PATH
    export MANPATH=/usr/local/share/man:$MANPATH

    export DEBIAN_FRONTEND=noninteractive
    export DEBCONF_NONINTERACTIVE_SEEN=true

    # ================================================================
    # Install base development packages
    # ================================================================
    apt-get update
    apt-get install -y --no-install-recommends \
        software-properties-common \
        strace \
        libnuma-dev \
        libibverbs-dev \
        librdmacm-dev \
        libssl-dev \
        curl \
        wget \
        git \
        bash \
        make \
        file \
        pkg-config \
        gcc \
        g++ \
        gfortran \
        python3-dev \
        python3-pip \
        autotools-dev \
        autoconf \
        libtool-bin \
        libopenblas-dev \
        libncurses5-dev \
        cmake \
        ca-certificates \
        bzip2 \
        xz-utils \
        automake \
        ninja-build \
        bison \
        flex \
        libboost-timer-dev \
        libpugixml-dev \
        libspdlog-dev

    # ================================================================
    # Install AMD AOCC compiler (optimized for Zen4/Zen3)
    # ================================================================
    cd /tmp
    wget -q https://download.amd.com/developer/eula/aocc/aocc-5-0/aocc-compiler-${AOCC_VERSION}_1_amd64.deb
    dpkg -i aocc-compiler-${AOCC_VERSION}_1_amd64.deb
    rm aocc-compiler-${AOCC_VERSION}_1_amd64.deb

    # Configure AOCC environment
    . /opt/AMD/aocc-compiler-${AOCC_VERSION}/setenv_AOCC.sh
    export CC=clang
    export CXX=clang++
    export FC=flang

    # Optimization flags for Milan (Zen3)
    export OPT_FLAGS="-O3 -march=znver3"
    export CFLAGS="${OPT_FLAGS}"
    export CXXFLAGS="${OPT_FLAGS}"
    export FFLAGS="${OPT_FLAGS}"

    # ================================================================
    # Build MPI Stack (copied from NEMO2 base recipe/GPAW)
    # ================================================================
    
    # HWLOC
    curl -sL https://download.open-mpi.org/release/hwloc/v2.10/hwloc-${HWLOC_VERSION}.tar.bz2 | tar --no-same-owner -xjC /tmp
    cd /tmp/hwloc-${HWLOC_VERSION} && ./configure --prefix=/usr/local && make -j$(nproc) install && rm -rf /tmp/hwloc-${HWLOC_VERSION}

    # Libfabric
    curl -sL https://github.com/ofiwg/libfabric/releases/download/v${LIBFABRIC_VERSION}/libfabric-${LIBFABRIC_VERSION}.tar.bz2 | tar --no-same-owner -xjC /tmp
    cd /tmp/libfabric-${LIBFABRIC_VERSION} && ./configure --prefix=/usr/local --disable-efa --enable-tcp --enable-shm --enable-verbs && make -j$(nproc) install && rm -rf /tmp/libfabric-${LIBFABRIC_VERSION}

    # MUNGE
    curl -sL https://github.com/dun/munge/releases/download/munge-${MUNGE_VERSION}/munge-${MUNGE_VERSION}.tar.xz | tar --no-same-owner -xJC /tmp
    cd /tmp/munge-${MUNGE_VERSION} && ./configure --prefix=/usr/local && make -j$(nproc) install && rm -rf /tmp/munge-${MUNGE_VERSION}

    # Libevent
    curl -sL https://github.com/libevent/libevent/releases/download/release-${LIBEVENT_VERSION}-stable/libevent-${LIBEVENT_VERSION}-stable.tar.gz | tar --no-same-owner -xzC /tmp
    cd /tmp/libevent-${LIBEVENT_VERSION}-stable && ./configure --prefix=/usr/local && make -j$(nproc) install && rm -rf /tmp/libevent-${LIBEVENT_VERSION}-stable

    # UCX
    curl -sL https://github.com/openucx/ucx/releases/download/v${UCX_VERSION}/ucx-${UCX_VERSION}.tar.gz | tar --no-same-owner -xzC /tmp
    cd /tmp/ucx-${UCX_VERSION} && CFLAGS="${CFLAGS} -Wno-unused-but-set-variable" CXXFLAGS="${CXXFLAGS} -Wno-unused-but-set-variable" ./configure --prefix=/usr/local --enable-optimizations --enable-cma --enable-mt --with-verbs --without-java --without-go --disable-doxygen-doc --disable-logging --disable-debug --disable-assertions --disable-params-check && make -j$(nproc) install && rm -rf /tmp/ucx-${UCX_VERSION}

    # UCC
    ldconfig
    curl -sL https://github.com/openucx/ucc/archive/refs/tags/v${UCC_VERSION}.tar.gz | tar --no-same-owner -xzC /tmp
    cd /tmp/ucc-${UCC_VERSION} && ./autogen.sh && ./configure --prefix=/usr/local --with-ucx=/usr/local && make -j$(nproc) install && rm -rf /tmp/ucc-${UCC_VERSION}

    # PMIx
    curl -sL https://github.com/openpmix/openpmix/releases/download/v${PMIX_VERSION}/pmix-${PMIX_VERSION}.tar.bz2 | tar --no-same-owner -xjC /tmp
    cd /tmp/pmix-${PMIX_VERSION} && ./configure --prefix=/usr/local --with-libevent=/usr/local --with-hwloc=/usr/local && make -j$(nproc) install && rm -rf /tmp/pmix-${PMIX_VERSION}

    # PRRTE
    curl -sL https://github.com/openpmix/prrte/releases/download/v${PRRTE_VERSION}/prrte-${PRRTE_VERSION}.tar.bz2 | tar --no-same-owner -xjC /tmp
    cd /tmp/prrte-${PRRTE_VERSION} && ./configure --prefix=/usr/local --with-libevent=/usr/local --with-hwloc=/usr/local --with-pmix=/usr/local && make -j$(nproc) install && rm -rf /tmp/prrte-${PRRTE_VERSION}

    # OpenMPI
    curl -sL https://download.open-mpi.org/release/open-mpi/v5.0/openmpi-${OMPI_VERSION}.tar.bz2 | tar --no-same-owner -xjC /tmp
    cd /tmp/openmpi-${OMPI_VERSION} && ./configure --prefix=/usr/local --enable-shared --without-orte --disable-oshmem --without-verbs --without-psm2 --with-hwloc=/usr/local --with-libevent=/usr/local --with-ofi=/usr/local --with-ucx=/usr/local --with-ucc=/usr/local --with-pmix=/usr/local --with-prrte=/usr/local && make -j$(nproc) install && rm -rf /tmp/openmpi-${OMPI_VERSION}
    ldconfig

    # ================================================================
    # Build FFTW
    # ================================================================
    curl -sL http://www.fftw.org/fftw-${FFTW_VERSION}.tar.gz | tar --no-same-owner -xzC /tmp
    cd /tmp/fftw-${FFTW_VERSION} && CC=mpicc ./configure --prefix=/usr/local --enable-shared --enable-mpi --disable-fortran --enable-sse2 --enable-avx --enable-avx2 --enable-avx512 && make -j$(nproc) install && rm -rf /tmp/fftw-${FFTW_VERSION}

    # ================================================================
    # Build ScaLAPACK
    # ================================================================
    curl -sL https://github.com/Reference-ScaLAPACK/scalapack/archive/refs/tags/v${SCALAPACK_VERSION}.tar.gz | tar --no-same-owner -xzC /tmp
    cd /tmp/scalapack-${SCALAPACK_VERSION} && mkdir build && cd build && \
    cmake .. \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DCMAKE_C_COMPILER=mpicc \
        -DCMAKE_Fortran_COMPILER=mpif90 \
        -DCMAKE_C_FLAGS="${OPT_FLAGS}" \
        -DCMAKE_Fortran_FLAGS="${OPT_FLAGS}" \
        -DBUILD_SHARED_LIBS=ON \
        -DUSE_OPTIMIZED_LAPACK_BLAS=ON \
        -DSCALAPACK_BUILD_TESTS=OFF \
        -DBUILD_TESTING=OFF && \
    make -j$(nproc) scalapack && make install && rm -rf /tmp/scalapack-${SCALAPACK_VERSION}

    # ================================================================
    # Build HDF5 (Parallel)
    # ================================================================
    curl -sL https://github.com/HDFGroup/hdf5/archive/refs/tags/hdf5-$(echo ${HDF5_VERSION} | tr . _).tar.gz | tar --no-same-owner -xzC /tmp
    cd /tmp/hdf5-hdf5-$(echo ${HDF5_VERSION} | tr . _)
    CC=mpicc ./configure --prefix=/usr/local --enable-parallel --enable-shared --disable-fortran
    make -j$(nproc) install
    rm -rf /tmp/hdf5-hdf5-$(echo ${HDF5_VERSION} | tr . _)

    # ================================================================
    # Build PETSc
    # ================================================================
    curl -sL https://web.cels.anl.gov/projects/petsc/download/release-snapshots/petsc-${PETSC_VERSION}.tar.gz | tar --no-same-owner -xzC /tmp
    cd /tmp/petsc-${PETSC_VERSION}
    export PETSC_DIR=$PWD
    # PETSc configure script is sensitive to CC/CXX/FC, using MPI wrappers
    python3 ./configure \
        --prefix=/usr/local \
        --with-debugging=0 \
        --COPTFLAGS="${OPT_FLAGS}" \
        --CXXOPTFLAGS="${OPT_FLAGS}" \
        --FOPTFLAGS="${OPT_FLAGS}" \
        --with-shared-libraries=1 \
        --with-mpi-dir=/usr/local \
        --with-blaslapack-lib="-lopenblas" \
        --with-scalapack-lib="-lscalapack" \
        --with-scalapack-include=/usr/local/include \
        --with-hdf5-dir=/usr/local \
        --with-fftw-dir=/usr/local
    make all
    make install
    rm -rf /tmp/petsc-${PETSC_VERSION}

    # ================================================================
    # Build SLEPc
    # ================================================================
    curl -sL https://slepc.upv.es/download/distrib/slepc-${SLEPC_VERSION}.tar.gz | tar --no-same-owner -xzC /tmp
    cd /tmp/slepc-${SLEPC_VERSION}
    export SLEPC_DIR=$PWD
    export PETSC_DIR=/usr/local
    python3 ./configure --prefix=/usr/local
    make all
    make install
    cd /tmp
    rm -rf /tmp/slepc-${SLEPC_VERSION}

    # ================================================================
    # Install Python Build dependencies
    pip install --break-system-packages --no-cache-dir \
        numpy \
        scipy \
        matplotlib \
        setuptools \
        wheel \
        cffi \
        pytest \
        sympy \
        scikit-build-core \
        nanobind==${NANOBIND_VERSION}

    # Install mpi4py
    pip install --break-system-packages --no-cache-dir --no-binary mpi4py mpi4py==${MPI4PY_VERSION}

    # Install pybind11
    pip install --break-system-packages --no-cache-dir pybind11==${PYBIND11_VERSION}

    # ================================================================
    # Build FEniCS / DOLFINx components
    # ================================================================
    
    # Basix
    rm -rf /tmp/basix
    git clone --branch v${BASIX_VERSION} https://github.com/FEniCS/basix.git /tmp/basix
    cd /tmp/basix && cmake -G Ninja -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local && cmake --build build --target install
    cd /tmp/basix/python && pip install --break-system-packages --no-cache-dir .
    cd /tmp && rm -rf /tmp/basix

    # FEniCS-UFCx (UFCx is now provided by FFCx, but we can still clone and install it)
    rm -rf /tmp/ufcx
    git clone --branch v${UFCX_VERSION} https://github.com/FEniCS/ufcx.git /tmp/ufcx
    cd /tmp/ufcx && cmake -G Ninja -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local && cmake --build build --target install
    cd /tmp && rm -rf /tmp/ufcx

    # FEniCS-FFCx
    rm -rf /tmp/ffcx
    git clone --branch v${FFCX_VERSION} https://github.com/FEniCS/ffcx.git /tmp/ffcx
    # FFCx needs setuptools and other build deps, but it's pure python
    pip install --break-system-packages --no-cache-dir /tmp/ffcx
    rm -rf /tmp/ffcx

    # DOLFINx (C++ core)
    rm -rf /tmp/dolfinx
    git clone --branch v${DOLFINX_VERSION} https://github.com/FEniCS/dolfinx.git /tmp/dolfinx
    cd /tmp/dolfinx/cpp
    cmake -G Ninja -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DDOLFINX_ENABLE_ADIOS2=OFF \
        -DDOLFINX_ENABLE_KOKKOS=OFF \
        -DPython3_EXECUTABLE=/usr/bin/python3
    cmake --build build --target install

    # DOLFINx (Python interface)
    cd ../python
    # For DOLFINx python, we use cmake directly to avoid pip/scikit-build-core issues
    cmake -G Ninja -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local -DPETSC_DIR=/usr/local -DSLEPC_DIR=/usr/local
    cmake --build build --target install
    cd /tmp && rm -rf /tmp/dolfinx

    # ================================================================
    # Prepare staging area
    # ================================================================
    mkdir -p /staging/usr/local/lib
    mkdir -p /staging/usr/local/bin
    mkdir -p /staging/usr/lib
    mkdir -p /staging/etc

    # Shared libraries
    find /usr/local/lib -name "*.so*" -type f -exec cp -a {} /staging/usr/local/lib/ \;
    find /usr/local/lib -name "*.so*" -type l -exec cp -a {} /staging/usr/local/lib/ \;
    
    # Plugins
    for p in ucx ucc openmpi pmix; do
        cp -a /usr/local/lib/$p /staging/usr/local/lib/ 2>/dev/null || true
    done

    # AOCC runtime
    cp -a /opt/AMD/aocc-compiler-*/lib/libflang*.so* /staging/usr/local/lib/ 2>/dev/null || true
    cp -a /opt/AMD/aocc-compiler-*/lib/libFortran*.so* /staging/usr/local/lib/ 2>/dev/null || true
    cp -a /opt/AMD/aocc-compiler-*/lib/libomp*.so* /staging/usr/local/lib/ 2>/dev/null || true
    cp -a /opt/AMD/aocc-compiler-*/lib/libamdlibm*.so* /staging/usr/local/lib/ 2>/dev/null || true
    cp -a /opt/AMD/aocc-compiler-*/lib/libpgmath*.so* /staging/usr/local/lib/ 2>/dev/null || true

    # Python packages
    cp -a /usr/local/lib/python3* /staging/usr/local/lib/

    # Binaries
    for b in mpirun mpiexec orte* ompi*; do
        cp -a /usr/local/bin/$b /staging/usr/local/bin/ 2>/dev/null || true
    done

    # System libs
    for l in libopenblas libblas liblapack libgomp libgfortran libquadmath libatomic libibverbs librdmacm libnl-3 libnl-route-3 libnuma libltdl libxml2; do
        cp -a /usr/lib/x86_64-linux-gnu/$l*.so* /staging/usr/lib/ 2>/dev/null || true
    done

    # Build info
    cat > /staging/etc/dolfinx-build-info << EOF
DOLFINX_VERSION=${DOLFINX_VERSION}
PETSC_VERSION=${PETSC_VERSION}
SLEPC_VERSION=${SLEPC_VERSION}
OMPI_VERSION=${OMPI_VERSION}
BUILD_DATE=$(date -Iseconds)
EOF

######################################################################
# STAGE 2: RUNTIME
######################################################################

Bootstrap: docker
From: ubuntu:24.04
Stage: runtime

%files from build
    /staging/usr/local/ /usr/local
    /staging/usr/lib/ /usr/lib
    /staging/etc/dolfinx-build-info /etc/dolfinx-build-info

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip libstdc++6 libgcc-s1 libc6 zlib1g liblzma5 libffi8 libopenblas0 libgfortran5 libnuma1 ibverbs-providers ca-certificates \
        && apt-get clean && rm -rf /var/lib/apt/lists/*

    pip install --break-system-packages --no-cache-dir numpy scipy matplotlib cffi sympy nanobind

    cat > /etc/ld.so.conf.d/dolfinx.conf << 'EOF'
/usr/local/lib
/usr/local/lib/openmpi
/usr/lib
EOF
    ldconfig

%environment
    export PATH=/usr/local/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/lib:/usr/local/lib/openmpi:$LD_LIBRARY_PATH
    export PYTHONPATH=/usr/local/lib/python3.12/dist-packages:$PYTHONPATH
    export OPAL_PREFIX=/usr/local
    export PYTHONUNBUFFERED=1
    export PYTHONUSERSITE=1
    export LC_ALL=C

%runscript
    python3 "$@"

%help
    DOLFINx (FEniCS) for NEMO2 (AMD EPYC Milan/Zen3)
    
    Features:
      - DOLFINx 0.10.0.post5
      - PETSc 3.21.5 & SLEPc 3.21.2
      - OpenMPI 5.0.7 with UCX/InfiniBand support
      - Multi-stage build for minimal image size

    Usage:
      srun apptainer run dolfinx.sif script.py
